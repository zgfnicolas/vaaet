{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)",
      "Bash(git branch -a)",
      "Bash(git branch -v*)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(ruff check *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(pyright *)",
      "Bash(python -m compileall *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout -b *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Bash(alembic *)",
      "Bash(dvc push *)",
      "Bash(dvc pull *)",
      "Bash(dvc add *)",
      "Bash(dvc commit *)",
      "Bash(vaaet-registry *)",
      "Bash(psql *)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./.dvc/config.local)",
      "Read(./**/*.private.json)",
      "Read(./vaaet-ml/data/private/**)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./.dvc/config.local)",
      "Edit(./**/*.private.json)",
      "Edit(./vaaet-ml/data/private/**)",
      "Edit(./**/*.keras)",
      "Edit(./**/*.joblib)",
      "Edit(./**/*.pt)",
      "Edit(./**/*.h5)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(dvc gc*)",
      "Bash(alembic * downgrade*)",
      "Bash(rm -rf *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git clean -*f*)",
      "Bash(alembic downgrade*)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
